				<key>ActionName</key>
				<string>Run AppleScript</string>
				<key>ActionParameters</key>
				<dict>
					<key>source</key>
					<string>on run {input, parameters}	delay 1	repeat with theURL in input		tell application "Google Chrome" to open location theURL	end repeat	return inputend run</string>
